# SSH alias configured in ~/.ssh/config
SCIDIAG_REMOTE_HOST=server-114
SCIDIAG_REMOTE_WORKSPACE=~/scidiagnose-demo
# Optional virtual environment Python. Defaults to python3.
# SCIDIAG_REMOTE_PYTHON=~/venvs/scidiag/bin/python

# School LLM API (OpenAI-compatible Chat Completions endpoint)
SCIDIAG_MODEL_PROVIDER=openai_compatible
# SCIDIAG_BASE_URL=https://<school-api-host>/v1
# SCIDIAG_MODEL_NAME=<school-model-name>
# Set only in your shell or an ignored .env file; never commit a real key.
# SCIDIAG_API_KEY=
